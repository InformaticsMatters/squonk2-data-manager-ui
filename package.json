{
  "name": "@squonk/data-manager-ui",
  "author": "Oliver Dudgeon",
  "license": "Apache-2.0",
  "version": "7.0.0-dev.4",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/InformaticsMatters/squonk2-data-manager-ui"
  },
  "engines": {
    "node": "24",
    "pnpm": "11"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "next dev --webpack",
    "dev:debug": "NODE_OPTIONS='--inspect' next dev --webpack",
    "build": "next build --webpack",
    "generate:client:account-server": "node --experimental-strip-types tools/openapi/generate-client.ts account-server",
    "generate:client:data-manager": "node --experimental-strip-types tools/openapi/generate-client.ts data-manager",
    "generate:clients": "node --experimental-strip-types tools/openapi/generate-client.ts all",
    "start": "next start",
    "tsc": "next typegen && tsc --pretty --noEmit",
    "lint": "eslint --cache --max-warnings=0",
    "format": "eslint --fix --cache --max-warnings=0",
    "test": "pnpm test:acceptance && playwright test --config=playwright.config.ts",
    "test:acceptance": "tsx tools/testing/run-acceptance.ts",
    "test:acceptance:headed": "tsx tools/testing/run-acceptance.ts --headed",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "test:debug": "pnpm test:acceptance:headed",
    "test:ci": "pnpm test",
    "analyze": "ANALYZE=true next build --webpack",
    "analyze:server": "BUNDLE_ANALYZE=server next build --webpack",
    "analyze:browser": "BUNDLE_ANALYZE=browser next build --webpack"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.@(json|md|mdx|css|scss|html)": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.10.2",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/server": "11.11.0",
    "@emotion/styled": "11.14.1",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@mui/icons-material": "9.0.1",
    "@mui/lab": "9.0.0-beta.3",
    "@mui/material": "9.0.1",
    "@mui/material-nextjs": "9.0.1",
    "@next/mdx": "16.2.6",
    "@rjsf/core": "6.5.3",
    "@rjsf/mui": "6.5.3",
    "@rjsf/utils": "6.5.3",
    "@rjsf/validator-ajv8": "6.5.3",
    "@sentry/nextjs": "10.53.1",
    "@squonk/mui-theme": "6.0.1",
    "@squonk/sdf-parser": "1.3.1",
    "@tanstack/match-sorter-utils": "8.19.4",
    "@tanstack/react-form": "1.32.0",
    "@tanstack/react-query": "5.100.11",
    "@tanstack/react-query-devtools": "5.100.11",
    "@tanstack/react-table": "8.21.3",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.12.4",
    "@types/plotly.js": "3.0.10",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.15",
    "@types/react-plotly.js": "2.6.4",
    "@types/semver": "7.7.1",
    "axios": "1.18.1",
    "better-auth": "1.6.11",
    "dayjs": "1.11.20",
    "filesize": "11.0.17",
    "immer": "11.1.8",
    "jotai": "2.20.0",
    "just-compare": "2.3.0",
    "just-group-by": "2.2.0",
    "jwt-decode": "4.0.0",
    "ketcher-core": "3.12.0",
    "ketcher-react": "3.12.0",
    "ketcher-standalone": "3.12.0",
    "lodash-es": "4.18.1",
    "material-ui-popup-state": "5.3.7",
    "nanoid": "5.1.11",
    "next": "16.2.6",
    "next-http-proxy-middleware": "1.2.8",
    "nextjs-routes": "2.2.5",
    "node-fetch": "3.3.2",
    "notistack": "3.0.2",
    "plotly.js-basic-dist": "3.5.1",
    "prismjs": "1.30.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-dropzone": "15.0.0",
    "react-plotly.js": "2.6.0",
    "react-use-websocket": "4.13.0",
    "semver": "7.8.0",
    "sharp": "0.34.5",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "use-immer": "0.11.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.61.0",
    "@bufbuild/protoc-gen-es": "2.10.2",
    "@playwright/test": "1.60.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@squonk/eslint-config": "3.1.0",
    "eslint": "10.4.0",
    "husky": "9.1.7",
    "identity-obj-proxy": "3.0.0",
    "lint-staged": "17.0.5",
    "orval": "8.22.0",
    "prettier": "3.8.3",
    "semantic-release": "25.0.3",
    "ts-morph": "28.0.0"
  },
  "nextBundleAnalysis": {
    "budget": 358400,
    "budgetPercentIncreaseRed": 20,
    "showDetails": true
  },
  "pnpm": {}
}
