# NextJS will use a standalone output by default
OUTPUT_TYPE="standalone"
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_VERSION=$npm_package_version

NEXT_PUBLIC_BASE_PATH=$BASE_PATH
BETTER_AUTH_BASE_URL=$BASE_URL$VERCEL_URL
KEYCLOAK_ISSUER_URL=$KEYCLOAK_URL
NEXT_PUBLIC_KEYCLOAK_ISSUER_URL=$KEYCLOAK_URL
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=$KEYCLOAK_CLIENT_ID

NEXT_PUBLIC_DATA_MANAGER_API_SERVER=$DATA_MANAGER_API_SERVER
NEXT_PUBLIC_ACCOUNT_SERVER_API_SERVER=$ACCOUNT_SERVER_API_SERVER
NEXT_PUBLIC_DEPICT_API_SERVER=$DEPICT_API_SERVER

# Keycloak Required Roles
# Used to protect routes that consume the DM-API
NEXT_PUBLIC_KEYCLOAK_DM_EVALUATOR_ROLE='data-manager-evaluator'
NEXT_PUBLIC_KEYCLOAK_DM_USER_ROLE='data-manager-user'
NEXT_PUBLIC_KEYCLOAK_DM_ADMIN_ROLE='data-manager-admin'
NEXT_PUBLIC_KEYCLOAK_AS_EVALUATOR_ROLE='account-server-evaluator'
NEXT_PUBLIC_KEYCLOAK_AS_USER_ROLE='account-server-user'
NEXT_PUBLIC_KEYCLOAK_AS_ADMIN_ROLE='account-server-admin'

NEXT_PUBLIC_DEFAULT_ORG_NAME='Default'

SENTRY_IGNORE_API_RESOLUTION_ERROR=1
# SENTRY_LOG_LEVEL='debug'
